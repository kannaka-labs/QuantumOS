[Unit]
Description=QuantumOS daily QPU calibration circuit (#275): Bell, fixed shots, public series
Documentation=file:///opt/qos-qpu/README.md
# Ordered after the broker but not bound to it: if the broker is down, this still runs and
# records an "error" row, so a bad day is never a silent gap.
After=qos-qpu-broker.service

[Service]
Type=oneshot
User=qosqpu
Group=qosqpu
# No API key here: this only talks to the broker's socket, which holds the key and
# applies the same device choice, per-job cap and daily budget as a visitor's job.
StateDirectory=qos-qpu
StateDirectoryMode=0750
ExecStart=/usr/bin/python3 -u /opt/qos-qpu/qpu_calibrate.py \
    --socket /run/qos-qpu/broker.sock \
    --series /var/lib/qos-qpu/calibration.jsonl \
    --json /var/lib/qos-qpu/calibration.json
# A QPU queue can take hours; the script records a "timeout" row at 20 h.
TimeoutStartSec=21h
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
CapabilityBoundingSet=
