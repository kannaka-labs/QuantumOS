{
  "_comment": "QuantumOS hub: one MCP endpoint for the Kannaka ecosystem. Copy, fix the paths, and point your AI at `qos_hub.py serve --config hub.json --db broker.db`. Reads are allowed; anything that writes to a shared bus, spends, or changes a store asks first; credit grants are denied. Unlisted tools ask.",
  "servers": {
    "kannaka": {
      "command": "node",
      "args": [
        "~/.claude/plugins/marketplaces/kannaka/plugins/kannaka/mcp/kannaka-mcp.mjs"
      ],
      "env": {
        "KANNAKA_BIN": "/usr/local/bin/kannaka"
      }
    },
    "quantum": {
      "command": "python3",
      "args": [
        "-m",
        "kannaka_quantum",
        "mcp"
      ],
      "env": {},
      "call_timeout_s": 600
    },
    "octo": {
      "command": "node",
      "args": [
        "~/Source/Kannaktopus/mcp-server/dist/index.js"
      ],
      "env": {}
    },
    "broker": {
      "command": "python3",
      "args": [
        "~/QuantumOS/tools/provider-broker/broker_mcp.py"
      ],
      "env": {
        "QOS_BROKER_SOCKET": "/run/qos-broker/broker.sock"
      }
    },
    "kcli": {
      "cli": {
        "binary": "~/.local/bin/kannaka",
        "env": {
          "KANNAKA_QUIET": "1"
        },
        "timeout_s": 90,
        "tools": {
          "status": {
            "description": "HRM status (the CLI, same as the plugin's).",
            "argv": [
              "status"
            ]
          },
          "recall": {
            "description": "Search memories.",
            "argv": [
              "recall",
              "{query}",
              "--top-k",
              "{k}"
            ],
            "params": {
              "query": {
                "type": "string",
                "max_len": 200
              },
              "k": {
                "type": "integer",
                "min": 1,
                "max": 20,
                "default": 5
              }
            }
          },
          "swarm_status": {
            "description": "Swarm snapshot.",
            "argv": [
              "swarm",
              "status"
            ]
          }
        }
      }
    },
    "scada": {
      "cli": {
        "binary": [
          "node",
          "~/Source/0xSCADA/cli/dist/index.js"
        ],
        "env": {
          "OXSCADA_API_URL": "http://localhost:5000",
          "NO_COLOR": "1"
        },
        "timeout_s": 60,
        "tools": {
          "status": {
            "description": "0xSCADA system health (database, blockchain, services).",
            "argv": [
              "status",
              "--json"
            ]
          },
          "sites": {
            "description": "List registered sites.",
            "argv": [
              "sites",
              "list",
              "--json"
            ]
          },
          "site": {
            "description": "One site.",
            "argv": [
              "sites",
              "get",
              "{id}",
              "--json"
            ],
            "params": {
              "id": {
                "type": "string",
                "pattern": "[A-Za-z0-9_.:-]{1,64}"
              }
            }
          },
          "assets": {
            "description": "List registered assets.",
            "argv": [
              "assets",
              "list",
              "--json"
            ]
          },
          "asset": {
            "description": "One asset.",
            "argv": [
              "assets",
              "get",
              "{id}",
              "--json"
            ],
            "params": {
              "id": {
                "type": "string",
                "pattern": "[A-Za-z0-9_.:-]{1,64}"
              }
            }
          },
          "events": {
            "description": "List event anchors.",
            "argv": [
              "events",
              "list",
              "--json",
              "--limit",
              "{limit}"
            ],
            "params": {
              "limit": {
                "type": "integer",
                "min": 1,
                "max": 100,
                "default": 20
              }
            }
          },
          "blockchain": {
            "description": "Blockchain connection status.",
            "argv": [
              "blockchain",
              "info",
              "--json"
            ]
          },
          "asset_create": {
            "description": "Register an asset on a site.",
            "argv": [
              "assets",
              "create",
              "--site",
              "{site}",
              "--name",
              "{name}",
              "--type",
              "{type}",
              "--json"
            ],
            "params": {
              "site": {
                "type": "string",
                "pattern": "[A-Za-z0-9_.:-]{1,64}"
              },
              "name": {
                "type": "string",
                "pattern": "[A-Za-z0-9_.:-]{1,64}"
              },
              "type": {
                "type": "string",
                "enum": [
                  "PLC",
                  "HMI",
                  "Sensor"
                ]
              }
            }
          }
        }
      }
    },
    "steward": {
      "cli": {
        "binary": [
          "node",
          "~/Source/kannaka-steward/dist/cli.js"
        ],
        "cwd": "~/Source/kannaka-steward",
        "timeout_s": 120,
        "tools": {
          "govern": {
            "description": "Check a governance proposal against a charter and a warrant; emits a human-signable package only if both pass. Never signs or submits.",
            "argv": [
              "govern",
              "--charter",
              "{charter}",
              "--proposal",
              "{proposal}",
              "--warrant",
              "{warrant}"
            ],
            "params": {
              "charter": {
                "type": "string",
                "pattern": "charters/[a-z0-9_-]{1,40}[.]yaml"
              },
              "proposal": {
                "type": "string",
                "pattern": "[A-Za-z0-9_-]{1,64}"
              },
              "warrant": {
                "type": "string",
                "enum": [
                  "granted",
                  "revoked",
                  "overscope"
                ]
              }
            }
          },
          "trade": {
            "description": "Same discipline for a market position: dry-run and a signable package only. Never signs or submits.",
            "argv": [
              "trade",
              "--charter",
              "{charter}",
              "--market",
              "{market}",
              "--warrant",
              "{warrant}"
            ],
            "params": {
              "charter": {
                "type": "string",
                "pattern": "charters/[a-z0-9_-]{1,40}[.]yaml"
              },
              "market": {
                "type": "string",
                "pattern": "[A-Za-z0-9_-]{1,64}"
              },
              "warrant": {
                "type": "string",
                "enum": [
                  "granted",
                  "revoked",
                  "overscope"
                ]
              }
            }
          }
        }
      }
    },
    "hdl": {
      "cli": {
        "binary": "~/.cargo/bin/kannaka-hdl",
        "cwd": "~/Source/kannaka-hdl",
        "timeout_s": 60,
        "tools": {
          "check": {
            "description": "Parse and type-check a KannakaHDL program (one of the repository's examples).",
            "argv": [
              "check",
              "{file}"
            ],
            "params": {
              "file": {
                "type": "string",
                "pattern": "examples/[a-z0-9-]{1,40}[.]khdl"
              }
            }
          },
          "grow": {
            "description": "Grow a program into its Abstract Holographic Plan as JSON, resolving base cases against the local registries; unresolved components are stubbed, never invented.",
            "argv": [
              "grow",
              "{file}",
              "--emit",
              "json",
              "--unresolved",
              "stub"
            ],
            "params": {
              "file": {
                "type": "string",
                "pattern": "examples/[a-z0-9-]{1,40}[.]khdl"
              }
            }
          }
        }
      }
    },
    "apps": {
      "cli": {
        "binary": [
          "node",
          "~/Source/kannaka-apps/runtime/khdl-app.mjs"
        ],
        "cwd": "~/Source/kannaka-apps/apps",
        "timeout_s": 300,
        "tools": {
          "list": {
            "description": "The KHDL app store: every installed app with its kind and summary.",
            "argv": [
              "list"
            ]
          },
          "plan": {
            "description": "Resolve an app against the live substrate and show what it WOULD do (--dry-run executes nothing).",
            "argv": [
              "run",
              "{app}",
              "--dry-run"
            ],
            "params": {
              "app": {
                "type": "string",
                "enum": [
                  "preflight",
                  "provisioner",
                  "research-scheduler",
                  "crystal-worker",
                  "mind"
                ]
              }
            }
          },
          "run": {
            "description": "Run an app for real: a gate exits by its verdict, a provision app seeds the HRM, a schedule or work app writes orders. One-way operations on live memory.",
            "argv": [
              "run",
              "{app}"
            ],
            "params": {
              "app": {
                "type": "string",
                "enum": [
                  "preflight",
                  "provisioner",
                  "research-scheduler",
                  "crystal-worker",
                  "mind"
                ]
              }
            }
          }
        }
      }
    },
    "buzz": {
      "cli": {
        "binary": "~/.cargo/bin/buzz",
        "env": {
          "BUZZ_RELAY_URL": "http://localhost:3000"
        },
        "timeout_s": 60,
        "tools": {
          "channels": {
            "description": "List the Hive's channels (kannaka-buzz, the constellation's Buzz relay). JSON out.",
            "argv": [
              "channels",
              "list"
            ]
          },
          "messages": {
            "description": "Recent messages of one channel.",
            "argv": [
              "messages",
              "get",
              "--channel",
              "{channel}",
              "--limit",
              "{limit}"
            ],
            "params": {
              "channel": {
                "type": "string",
                "pattern": "[0-9a-fA-F-]{36}"
              },
              "limit": {
                "type": "integer",
                "min": 1,
                "max": 100,
                "default": 20
              }
            }
          },
          "search": {
            "description": "Full-text search across the Hive's messages.",
            "argv": [
              "messages",
              "search",
              "--query",
              "{query}"
            ],
            "params": {
              "query": {
                "type": "string",
                "max_len": 200
              }
            }
          },
          "send": {
            "description": "Post a message to a channel as the configured identity. A write other members read.",
            "argv": [
              "messages",
              "send",
              "--channel",
              "{channel}",
              "--content",
              "{content}"
            ],
            "params": {
              "channel": {
                "type": "string",
                "pattern": "[0-9a-fA-F-]{36}"
              },
              "content": {
                "type": "string",
                "max_len": 2000
              }
            }
          }
        }
      }
    },
    "lens": {
      "cli": {
        "binary": "~/.local/bin/lens",
        "timeout_s": 600,
        "tools": {
          "show": {
            "description": "Print an existing kannaka-lens project record (what a clip was seen as: shots, motion, colour, sound). JSON out.",
            "argv": [
              "show",
              "--project",
              "{project}",
              "--json"
            ],
            "params": {
              "project": {
                "type": "string",
                "pattern": "[A-Za-z0-9_][A-Za-z0-9_./-]{0,200}[.]lens"
              }
            }
          },
          "run": {
            "description": "Run the perception pipeline over a clip (ffmpeg plus the kannaka eye); writes CLIP.lens next to it and what was seen lands in the HRM.",
            "argv": [
              "run",
              "{clip}"
            ],
            "params": {
              "clip": {
                "type": "string",
                "pattern": "[A-Za-z0-9_][A-Za-z0-9_./-]{0,200}[.](mp4|mkv|mov|webm|wav|mp3)"
              }
            }
          }
        }
      }
    },
    "city": {
      "url": "https://kax.ninja-portal.com/api/mcp",
      "auth": {
        "bearer_file": "~/.kannaka/kax-token-kannaka.txt",
        "refresh_url": "https://kax.ninja-portal.com/api/auth/token/refresh",
        "refresh_every_s": 600
      }
    },
    "review": {
      "command": "qos-review",
      "args": [
        "serve",
        "--config",
        "~/.qos-review/review.json"
      ],
      "env": {}
    }
  },
  "policy": {
    "kannaka.kannaka_status": "allow",
    "kannaka.kannaka_recall": "allow",
    "kannaka.swarm_status": "allow",
    "kannaka.swarm_tail": "allow",
    "kannaka.compute_machines": "allow",
    "kannaka.compute_status": "allow",
    "kannaka.compute_events": "allow",
    "kannaka.kannaka_remember": "ask",
    "kannaka.kannaka_dream": "ask",
    "kannaka.swarm_send": "ask",
    "kannaka.compute_wake": "ask",
    "kannaka.compute_grant": "deny",
    "quantum.quantum_devices": "allow",
    "quantum.quantum_random": "allow",
    "quantum.resonance_recall": "allow",
    "quantum.run_circuit": "ask",
    "octo.octopus_status": "allow",
    "octo.octopus_list_skills": "allow",
    "octo.kannaka_status": "allow",
    "octo.kannaka_recall": "allow",
    "octo.kannaka_observe": "allow",
    "octo.kannaka_constellation": "allow",
    "octo.hrm_*": "allow",
    "octo.swarm_status": "allow",
    "octo.swarm_tail": "allow",
    "octo.swarm_send": "ask",
    "octo.kannaka_absorb": "ask",
    "octo.kannaka_dream": "ask",
    "octo.octopus_*": "ask",
    "broker.*": "allow",
    "kcli.status": "allow",
    "kcli.recall": "allow",
    "kcli.swarm_status": "allow",
    "steward.*": "allow",
    "city.city_look": "allow",
    "city.city_rooms": "allow",
    "city.city_onboarding": "allow",
    "city.joinery_catalog": "allow",
    "city.joinery_works": "allow",
    "city.joinery_mine": "allow",
    "city.city_enter": "ask",
    "city.city_say": "ask",
    "city.city_goto": "ask",
    "city.city_leave": "ask",
    "city.joinery_buy": "ask",
    "city.joinery_sell": "ask",
    "city.joinery_flat": "ask",
    "review.review_start": "ask",
    "review.*": "allow",
    "scada.status": "allow",
    "scada.sites": "allow",
    "scada.site": "allow",
    "scada.assets": "allow",
    "scada.asset": "allow",
    "scada.events": "allow",
    "scada.blockchain": "allow",
    "scada.asset_create": "ask",
    "hdl.check": "allow",
    "hdl.grow": "allow",
    "apps.list": "allow",
    "apps.plan": "allow",
    "apps.run": "ask",
    "buzz.channels": "allow",
    "buzz.messages": "allow",
    "buzz.search": "allow",
    "buzz.send": "ask",
    "lens.show": "allow",
    "lens.run": "ask"
  },
  "default": "ask"
}
