    "cc.get_market": "allow",
    "cc.market_leaderboard": "allow",
    "cc.my_market_account": "allow",
    "cc.compute_machines": "allow",
    "cc.compute_events": "allow",
    "cc.ask_kannaka": "ask",
    "cc.place_bet": "ask",
    "cc.propose_prediction": "ask",
    "cc.buy_credits": "ask",
    "cc.redeem_credits": "ask",
    "cc.wake_machine": "ask"
  },
  "default": "ask"
}
